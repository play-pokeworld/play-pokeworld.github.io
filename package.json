{
  "name": "pokeworld-clean",
  "version": "1.16.31",
  "private": true,
  "description": "PokéWorld — clean-architecture rework (static browser game + zero-dependency local server).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node test_suite.js",
    "audit:contrast": "node tools/contrast-audit.mjs --check",
    "audit:i18n": "node tools/i18n/audit-keys.mjs",
    "test:browser": "node tests/browser/FacilityParity.mjs",
    "data": "node tools/data/build-all.mjs",
    "test:browser:visual": "node tests/browser/FacilityVisualParity.mjs",
    "test:browser:feedback": "node tests/browser/FeedbackCorrections.mjs",
    "test:browser:automation": "node tests/browser/RelaunchAutomation.mjs",
    "test:browser:market": "node tests/browser/MarketAndResponsiveTraining.mjs",
    "test:browser:interaction": "node tests/browser/InteractionCorrections.mjs",
    "test:browser:backdrop": "node tests/browser/BackdropAndAutoContext.mjs",
    "test:browser:dictionary": "node tests/browser/DictionaryParity.mjs",
    "test:browser:baginfo": "node tests/browser/BagAndPokemonInfoParity.mjs",
    "test:browser:debugbox": "node tests/browser/DebugAndBoxItemUse.mjs",
    "test:browser:language": "node tests/browser/LanguageSwitch.mjs",
    "test:browser:fit": "node tests/browser/PanelFit.mjs",
    "test:browser:reported-mobile": "node tests/browser/ReportedMobileWindows.mjs",
    "test:browser:afk": "node tests/browser/AfkCatchUp.mjs",
    "test:browser:talents": "node tests/browser/TalentPools.mjs",
    "test:browser:training": "node tests/browser/TrainingWaves.mjs",
    "test:browser:roaming": "node tests/browser/RoamingOff.mjs",
    "test:browser:items": "node tests/browser/ItemSpriteSize.mjs",
    "test:browser:portrait": "node tests/browser/SaveCardPortrait.mjs",
    "test:browser:release11610": "node tests/browser/Release11610.mjs",
    "test:browser:release11611": "node tests/browser/Release11611.mjs",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build"
  },
  "devDependencies": {
    "playwright": "^1.47.2"
  }
}
